From 06a1200a6b1cc0b0f954890a589681a5b891690b Mon Sep 17 00:00:00 2001
From: Andreas Wendleder <andreas.wendleder@proton.me>
Date: Fri, 30 Oct 2026 09:29:09 +0100
Subject: [PATCH 2/7] LegalizeFunctionSignatures: keep the returned struct
 value

For a function returning a struct by value, every return was replaced by a
load from the first entry-block alloca of the return type. Any other local
of that type (TypesLegalizationPass creates one for a struct phi) then
became the return value. Only split a returned whole-struct load from an
alloca, from that alloca.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LqBCeZyWd3hVdxTTAumnrq
Signed-off-by: Andreas Wendleder <andreas.wendleder@proton.me>
---
 .../LegalizeFunctionSignatures.cpp            | 23 ++++++-------
 .../struct-ret-byval-other-alloca.ll          | 32 +++++++++++++++++++
 2 files changed, 41 insertions(+), 14 deletions(-)
 create mode 100644 IGC/Compiler/tests/LegalizeFunctionSignatures/struct-ret-byval-other-alloca.ll

diff --git a/IGC/AdaptorCommon/LegalizeFunctionSignatures.cpp b/IGC/AdaptorCommon/LegalizeFunctionSignatures.cpp
index 7f7b84245..4be48f29a 100644
--- a/IGC/AdaptorCommon/LegalizeFunctionSignatures.cpp
+++ b/IGC/AdaptorCommon/LegalizeFunctionSignatures.cpp
@@ -402,20 +402,15 @@ void LegalizeFunctionSignatures::fixFunctionBodies(Module &M) {
         }
         break;
       case RetLowering::StructValue:
-        for (Instruction &I : NewF->getEntryBlock()) {
-          auto *AI = dyn_cast<AllocaInst>(&I);
-          if (AI && AI->getAllocatedType() == NewF->getReturnType()) {
-            SRetPtr = AI;
-            SRetTy = NewF->getReturnType();
-            break;
-          }
-        }
-        if (SRetPtr) {
-          for (ReturnInst *RI : Returns) {
-            IGCLLVM::IRBuilder<> RetBuilder(RI);
-            RetBuilder.CreateRet(loadFromStruct(RetBuilder, SRetPtr, SRetTy));
-            RI->eraseFromParent();
-          }
+        // Split a returned whole-struct load from an alloca into field loads. Any other return value
+        // stays as it is: another alloca of the return type holds a different value.
+        for (ReturnInst *RI : Returns) {
+          auto *LI = dyn_cast<LoadInst>(RI->getReturnValue());
+          if (!LI || !isa<AllocaInst>(LI->getPointerOperand()->stripPointerCasts()))
+            continue;
+          IGCLLVM::IRBuilder<> RetBuilder(RI);
+          RetBuilder.CreateRet(loadFromStruct(RetBuilder, LI->getPointerOperand(), NewF->getReturnType()));
+          RI->eraseFromParent();
         }
         break;
       case RetLowering::WidenInt:
diff --git a/IGC/Compiler/tests/LegalizeFunctionSignatures/struct-ret-byval-other-alloca.ll b/IGC/Compiler/tests/LegalizeFunctionSignatures/struct-ret-byval-other-alloca.ll
new file mode 100644
index 000000000..ce5afed41
--- /dev/null
+++ b/IGC/Compiler/tests/LegalizeFunctionSignatures/struct-ret-byval-other-alloca.ll
@@ -0,0 +1,32 @@
+;=========================== begin_copyright_notice ============================
+;
