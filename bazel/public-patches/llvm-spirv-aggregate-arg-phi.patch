diff --git a/llvm/test/CodeGen/SPIRV/aggregate-arg-phi.ll b/llvm/test/CodeGen/SPIRV/aggregate-arg-phi.ll
new file mode 100644
index 000000000..a153f4d9b
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/aggregate-arg-phi.ll
@@ -0,0 +1,27 @@
+; An aggregate argument feeding a PHI: CodeGenPrepare merges exit.pre into exit and
+; adds PHI edges, so it must not see the i32 placeholder the argument becomes.
+; RUN: llc -O2 -mtriple=spirv64-unknown-unknown %s -o - | FileCheck %s
+; RUN: llc -O2 -enable-new-pm -mtriple=spirv64-unknown-unknown %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O2 -mtriple=spirv64-unknown-unknown %s -o - -filetype=obj | spirv-val %}
+
+%S = type { i32, float }
+
+; CHECK: %[[#A:]] = OpFunctionParameter
+; CHECK: %[[#B:]] = OpFunctionParameter
+; CHECK: OpPhi %[[#]] %[[#B]] %[[#]] %[[#A]] %[[#]]
+define %S @f(%S %a, %S %b, i32 %k) {
+entry:
+  switch i32 %k, label %other [ i32 0, label %p1
+                                i32 1, label %p2 ]
+p1:
+  br label %exit.pre
+p2:
+  br label %exit.pre
+exit.pre:
+  br label %exit
+other:
+  br label %exit
+exit:
+  %r = phi %S [ %a, %exit.pre ], [ %b, %other ]
+  ret %S %r
+}
diff --git a/llvm/test/CodeGen/SPIRV/vk-pushconstant-aggregate-arg.ll b/llvm/test/CodeGen/SPIRV/vk-pushconstant-aggregate-arg.ll
new file mode 100644
index 000000000..8ab4b8dac
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/vk-pushconstant-aggregate-arg.ll
@@ -0,0 +1,43 @@
+; A function with an aggregate argument that reads a push constant. Removing
+; the aggregate types clones the function, so it must run before
+; SPIRVPushConstantAccess records the access in SPIRVGlobalRegistry, or the
+; record points into the erased original.
+
+; RUN: llc -O0 -verify-machineinstrs -mtriple=spirv-vulkan-unknown %s -o - | FileCheck %s
+; RUN: llc -O0 -verify-machineinstrs -enable-new-pm -mtriple=spirv-vulkan-unknown %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv-vulkan-unknown %s -o - -filetype=obj | spirv-val --target-env vulkan1.3 %}
+
+; CHECK-DAG: %[[#F32:]] = OpTypeFloat 32
+; CHECK-DAG: %[[#S:]] = OpTypeStruct %[[#F32]]{{$}}
+; CHECK-DAG: %[[#PTR:]] = OpTypePointer PushConstant %[[#S]]
+; CHECK-DAG: %[[#PCS:]] = OpVariable %[[#PTR]] PushConstant
+; CHECK: OpFunction
+; CHECK: OpFunctionParameter
+; CHECK: OpLoad %[[#F32]]
+
+%struct.S = type <{ float }>
+%struct.P = type { float, float }
+
+@pcs = external hidden addrspace(13) externally_initialized global %struct.S, align 1
+
+define internal float @helper(%struct.P %p) {
+entry:
+  %v = load float, ptr addrspace(13) @pcs, align 1
+  %x = extractvalue %struct.P %p, 0
+  %r = fadd float %v, %x
+  ret float %r
+}
+
+define void @main() #1 {
+entry:
+  %0 = call token @llvm.experimental.convergence.entry()
+  %1 = alloca float, align 4
+  %r = call float @helper(%struct.P { float 1.0, float 2.0 })
+  store float %r, ptr %1
+  ret void
+}
+
+declare token @llvm.experimental.convergence.entry() #2
+
+attributes #1 = { convergent noinline norecurse optnone "hlsl.numthreads"="1,1,1" "hlsl.shader"="compute" }
+attributes #2 = { convergent nocallback nofree nosync nounwind willreturn memory(none) }
