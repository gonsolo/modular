diff --git a/llvm/test/CodeGen/SPIRV/aggregate-arg-phi.ll b/llvm/test/CodeGen/SPIRV/aggregate-arg-phi.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/aggregate-arg-phi.ll
@@ -0,0 +1,55 @@
+; An aggregate argument feeding a PHI or select directly: generic passes that add
+; a PHI edge must not see the i32 placeholder it becomes for SPIRVEmitIntrinsics.
+; RUN: llc -O2 -mtriple=spirv64-unknown-unknown %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O2 -mtriple=spirv64-unknown-unknown %s -o - -filetype=obj | spirv-val %}
+; RUN: llc -O2 -mtriple=spirv64-unknown-unknown --spirv-ext=+SPV_KHR_poison_freeze %s -o - | FileCheck %s --check-prefix=FREEZE
+
+%S = type { i32, float }
+
+; FREEZE-NOT: OpFreezeKHR
+
+; CHECK: %[[#A:]] = OpFunctionParameter
+; CHECK: %[[#B:]] = OpFunctionParameter
+; CHECK: OpPhi %[[#]] %[[#B]] %[[#]] %[[#A]] %[[#]]
+define %S @f(%S %a, %S %b, i32 %k) {
+entry:
+  switch i32 %k, label %other [ i32 0, label %p1
+                                i32 1, label %p2 ]
+p1:
+  br label %exit.pre
+p2:
+  br label %exit.pre
+exit.pre:
+  br label %exit
+other:
+  br label %exit
+exit:
+  %r = phi %S [ %a, %exit.pre ], [ %b, %other ]
+  ret %S %r
+}
+
+; CHECK: %[[#C:]] = OpFunctionParameter
+; CHECK: %[[#D:]] = OpFunctionParameter
+; CHECK: OpSelect %[[#]] %[[#]] %[[#C]] %[[#D]]
+define %S @g(%S %c, %S %d, i1 %k) {
+  %r = select i1 %k, %S %c, %S %d
+  ret %S %r
+}
+
+; A PHI on an aggregate argument in a loop header: LoopSimplify adds a preheader.
+; CHECK: OpFunctionParameter
+; CHECK: OpPhi
+define %S @h(%S %a, i32 %n, i1 %c) {
+entry:
+  br i1 %c, label %loop, label %skip
+skip:
+  br label %loop
+loop:
+  %r = phi %S [ %a, %entry ], [ %a, %skip ], [ %r, %loop ]
+  %i = phi i32 [ 0, %entry ], [ 1, %skip ], [ %i2, %loop ]
+  %i2 = add i32 %i, 1
+  %done = icmp eq i32 %i2, %n
+  br i1 %done, label %exit, label %loop
+exit:
+  ret %S %r
+}
