+          Register Part = MIB.buildZExtOrTrunc(DstTy, Src).getReg(0);
+          if (Offset != 0) {
+            auto ShiftAmt = MIB.buildConstant(DstTy, Offset);
+            Part = MIB.buildShl(DstTy, Part, ShiftAmt).getReg(0);
+          }
+          Acc = MIB.buildOr(DstTy, Acc, Part).getReg(0);
+        }
+        MRI.replaceRegWith(Dst, Acc);
+        MI.eraseFromParent();
+      } else if (MI.getOpcode() == TargetOpcode::G_UNMERGE_VALUES) {
+        unsigned NumDefs = MI.getNumDefs();
+        if (NumDefs == 0 || MI.getNumOperands() != NumDefs + 1)
+          continue;
+        Register Src = MI.getOperand(NumDefs).getReg();
+        LLT SrcLLT = MRI.getType(Src);
+        if (SrcLLT.isValid() && SrcLLT.isVector())
+          continue;
+        unsigned SrcBits = getScalarBits(Src);
+        unsigned DstBits = getScalarBits(MI.getOperand(0).getReg());
+        if (SrcBits == 0 || DstBits == 0) {
+          if (NumDefs == 2)
+            SrcBits = DstBits = 64;
+        }
+        if (SrcBits == 0 || SrcBits > 64 || DstBits == 0)
+          continue;
+        LLT SrcTy = MRI.getType(Src);
+        if (!SrcTy.isValid() || !SrcTy.isScalar())
+          SrcTy = LLT::scalar(SrcBits);
+        MRI.setType(Src, SrcTy);
+        LLT DstTy = MRI.getType(MI.getOperand(0).getReg());
+        if (!DstTy.isValid() || !DstTy.isScalar())
+          DstTy = LLT::scalar(DstBits);
+        MachineIRBuilder MIB(MI);
+        for (unsigned I = 0; I < NumDefs; ++I) {
+          Register D = MI.getOperand(I).getReg();
+          if (!MRI.getType(D).isValid() || !MRI.getType(D).isScalar())
+            MRI.setType(D, DstTy);
+          Register Val;
+          unsigned Offset = I * DstBits;
+          if (Offset == 0) {
+            Val = MIB.buildTrunc(DstTy, Src).getReg(0);
+          } else if (Offset >= SrcBits) {
+            Val = MIB.buildConstant(DstTy, 0).getReg(0);
+          } else {
+            auto ShiftAmt = MIB.buildConstant(SrcTy, Offset);
+            auto Shifted = MIB.buildLShr(SrcTy, Src, ShiftAmt);
+            Val = MIB.buildTrunc(DstTy, Shifted).getReg(0);
+          }
+          MRI.replaceRegWith(D, Val);
+        }
+        MI.eraseFromParent();
+      }
+    }
+  }
+  // Erase any remaining dead wide merge/unmerge artifacts that could not be
+  // decomposed into representable SPIR-V operations.
+  for (MachineBasicBlock &MBB : MF) {
+    for (MachineInstr &MI : make_early_inc_range(MBB)) {
+      if (MI.getOpcode() == TargetOpcode::G_MERGE_VALUES) {
+        if (MI.getNumDefs() == 1 && MRI.use_nodbg_empty(MI.getOperand(0).getReg()))
+          MI.eraseFromParent();
+      } else if (MI.getOpcode() == TargetOpcode::G_UNMERGE_VALUES) {
+        bool AllDead = true;
+        for (unsigned I = 0, E = MI.getNumDefs(); I != E; ++I) {
+          if (!MRI.use_nodbg_empty(MI.getOperand(I).getReg())) {
+            AllDead = false;
+            break;
+          }
+        }
+        if (AllDead)
+          MI.eraseFromParent();
+      }
+    }
+  }
+  // Ensure every virtual register operand with a valid LLT has a SPIR-V type.
+  // Post-legalization rewrites can leave missing type assignments.
+  if (!MF.empty()) {
+    MachineIRBuilder MIB(*MF.begin(), MF.begin()->begin());
+    for (MachineBasicBlock &MBB : MF) {
+      for (MachineInstr &MI : MBB) {
+        for (MachineOperand &MO : MI.operands()) {
+          if (!MO.isReg())
+            continue;
+          Register R = MO.getReg();
+          if (!R || !R.isVirtual())
+            continue;
+          if (GR->getSPIRVTypeForVReg(R))
+            continue;
+          LLT Ty = MRI.getType(R);
+          if (!Ty.isValid())
+            continue;
+          SPIRVTypeInst SpvTy = nullptr;
+          if (Ty.isScalar()) {
+            unsigned BW = Ty.getSizeInBits();
+            if (BW == 1)
+              SpvTy = GR->getOrCreateSPIRVBoolType(MIB, false);
+            else
+              SpvTy = GR->getOrCreateSPIRVIntegerType(BW, MIB);
+          } else if (Ty.isVector()) {
+            LLT Elt = Ty.getElementType();
+            if (Elt.isScalar()) {
+              unsigned EBW = Elt.getSizeInBits();
+              SPIRVTypeInst ElemTy = (EBW == 1)
+                                         ? GR->getOrCreateSPIRVBoolType(MIB, false)
+                                         : GR->getOrCreateSPIRVIntegerType(EBW, MIB);
+              auto EC = Ty.getElementCount();
+              if (EC.isFixed())
+                SpvTy = GR->getOrCreateSPIRVVectorType(ElemTy, EC.getFixedValue(),
+                                                       MIB, false);
+            }
+          }
+          if (SpvTy)
+            GR->assignSPIRVTypeToVReg(SpvTy, R, MF);
+        }
+      }
+    }
+  }
+
   registerSpirvTypeForNewInstructions(MF, GR);
   ensureAssignTypeForTypeFolding(MF, GR);
+
+  // Ensure register classes are set for all typed virtual registers.
+  for (MachineBasicBlock &MBB : MF) {
+    for (MachineInstr &MI : MBB) {
+      for (MachineOperand &MO : MI.operands()) {
+        if (!MO.isReg())
+          continue;
+        Register R = MO.getReg();
+        if (!R || !R.isVirtual() || MRI.getRegClassOrNull(R))
+          continue;
+        SPIRVTypeInst Ty = GR->getSPIRVTypeForVReg(R);
+        if (!Ty)
+          continue;
+        if (const auto *RC = GR->getRegClass(Ty))
+          MRI.setRegClass(R, RC);
+      }
+    }
+  }
+
   return true;
 }
 
