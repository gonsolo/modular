From 9d9eefa83a6f74d56796aff51f6cd6ad9e8d9568 Mon Sep 17 00:00:00 2001
From: Andreas Wendleder <andreas.wendleder@proton.me>
Date: Thu, 5 Nov 2026 21:36:16 +0100
Subject: [PATCH 7/7] getAllDefinedMembers: a non-constant base struct defines
 every member

A struct select or insertvalue whose operand is a phi, argument or call
copied no members from it, so those lanes or fields kept stale data.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0141xq22BhyCNa4pRpmwvhAc
---
 IGC/Compiler/CISACodeGen/MemOpt.cpp           | 11 +++
 .../struct-members-from-nonconstant-base.ll   | 85 +++++++++++++++++++
 2 files changed, 96 insertions(+)
 create mode 100644 IGC/Compiler/tests/EmitVISAPass/struct-members-from-nonconstant-base.ll

diff --git a/IGC/Compiler/CISACodeGen/MemOpt.cpp b/IGC/Compiler/CISACodeGen/MemOpt.cpp
index 30c46fcdf..31244e175 100644
--- a/IGC/Compiler/CISACodeGen/MemOpt.cpp
+++ b/IGC/Compiler/CISACodeGen/MemOpt.cpp
@@ -5229,6 +5229,17 @@ void getAllDefinedMembers(const Value *IVI, SmallVectorImpl<std::vector<unsigned
   if (auto *S = dyn_cast<ConstantAggregate>(V)) {
     std::vector<unsigned> indices = {};
     searchForDefinedMembers(S, indices, fieldsTBC);
+  } else if (!isa<UndefValue>(V)) {
+    // Any other base (argument, call, phi, select, zeroinitializer) defines every member.
+    fieldsTBC.clear();
+    auto *StTy = cast<StructType>(IVI->getType());
+    for (unsigned i = StTy->getNumElements(); i-- > 0;) {
+      auto *SubTy = dyn_cast<StructType>(StTy->getElementType(i));
+      if (!SubTy)
+        fieldsTBC.push_back({i});
+      for (unsigned j = SubTy ? SubTy->getNumElements() : 0; j-- > 0;)
+        fieldsTBC.push_back({i, j});
+    }
   }
 
   // reverse the vector to get the ascending order of indices
diff --git a/IGC/Compiler/tests/EmitVISAPass/struct-members-from-nonconstant-base.ll b/IGC/Compiler/tests/EmitVISAPass/struct-members-from-nonconstant-base.ll
new file mode 100644
index 000000000..d5ddf1baf
--- /dev/null
+++ b/IGC/Compiler/tests/EmitVISAPass/struct-members-from-nonconstant-base.ll
@@ -0,0 +1,85 @@
