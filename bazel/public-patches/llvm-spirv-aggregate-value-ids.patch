diff --git a/llvm/test/CodeGen/SPIRV/instructions/extractvalue-aggregate-phi-select.ll b/llvm/test/CodeGen/SPIRV/instructions/extractvalue-aggregate-phi-select.ll
new file mode 100644
index 000000000..addb8b7d7
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/instructions/extractvalue-aggregate-phi-select.ll
@@ -0,0 +1,57 @@
+; An aggregate member taken out with extractvalue becomes an i32 value-id when
+; it feeds an aggregate PHI, select or freeze, which SPIRVEmitIntrinsics has
+; already rewritten to value-ids, and it needs its composite type assigned.
+
+; RUN: llc -O0 -mtriple=spirv64-unknown-unknown %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv64-unknown-unknown %s -o - -filetype=obj | spirv-val %}
+
+; CHECK-DAG: %[[#Float:]] = OpTypeFloat 32
+; CHECK-DAG: %[[#Int:]] = OpTypeInt 32 0
+; CHECK-DAG: %[[#Inner:]] = OpTypeStruct %[[#Float]] %[[#Float]] %[[#Float]]
+; CHECK-DAG: %[[#Outer:]] = OpTypeStruct %[[#Int]] %[[#Inner]]
+
+%Inner = type { float, float, float }
+%Outer = type { i32, %Inner }
+
+; CHECK: %[[#L0:]] = OpLoad %[[#Outer]]
+; CHECK: %[[#E0:]] = OpCompositeExtract %[[#Inner]] %[[#L0]] 1
+; CHECK: %[[#P:]] = OpPhi %[[#Inner]] %[[#E0]] %[[#]] %[[#]] %[[#]]
+; CHECK: OpCompositeExtract %[[#Float]] %[[#P]] 0
+define spir_kernel void @phi(ptr addrspace(1) %out, ptr addrspace(1) %in, i1 %c) {
+entry:
+  %s = load %Outer, ptr addrspace(1) %in
+  %v = extractvalue %Outer %s, 1
+  br i1 %c, label %zero, label %join
+zero:
+  br label %join
+join:
+  %p = phi %Inner [ %v, %entry ], [ zeroinitializer, %zero ]
+  %x = extractvalue %Inner %p, 0
+  store float %x, ptr addrspace(1) %out
+  ret void
+}
+
+; CHECK: %[[#L1:]] = OpLoad %[[#Outer]]
+; CHECK: %[[#E1:]] = OpCompositeExtract %[[#Inner]] %[[#L1]] 1
+; CHECK: %[[#S:]] = OpSelect %[[#Inner]] %[[#]] %[[#E1]] %[[#]]
+; CHECK: OpCompositeExtract %[[#Float]] %[[#S]] 1
+define spir_kernel void @select(ptr addrspace(1) %out, ptr addrspace(1) %in, i1 %c) {
+  %s = load %Outer, ptr addrspace(1) %in
+  %v = extractvalue %Outer %s, 1
+  %p = select i1 %c, %Inner %v, %Inner zeroinitializer
+  %x = extractvalue %Inner %p, 1
+  store float %x, ptr addrspace(1) %out
+  ret void
+}
+
+; CHECK: %[[#L2:]] = OpLoad %[[#Outer]]
+; CHECK: %[[#E2:]] = OpCompositeExtract %[[#Inner]] %[[#L2]] 1
+; CHECK: OpCompositeExtract %[[#Float]] %[[#]] 2
+define spir_kernel void @freeze(ptr addrspace(1) %out, ptr addrspace(1) %in) {
+  %s = load %Outer, ptr addrspace(1) %in
+  %v = extractvalue %Outer %s, 1
+  %f = freeze %Inner %v
+  %x = extractvalue %Inner %f, 2
+  store float %x, ptr addrspace(1) %out
+  ret void
+}
diff --git a/llvm/test/CodeGen/SPIRV/instructions/select-constant-arm-deduced-pointee.ll b/llvm/test/CodeGen/SPIRV/instructions/select-constant-arm-deduced-pointee.ll
new file mode 100644
index 000000000..74dd664c3
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/instructions/select-constant-arm-deduced-pointee.ll
@@ -0,0 +1,45 @@
+; A constant arm of an aggregate select or PHI holds pointer members whose
+; pointee types were deduced elsewhere in the module (constant expressions are
+; shared between functions): i8 for the one returned in @a, i32 for the one
+; loaded through in @a2. The arm is rebuilt with insertvalue, which casts each
+; member to the result's member type, so all arms have the result's type.
+
+; RUN: llc -O0 -mtriple=spirv64-unknown-unknown %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv64-unknown-unknown %s -o - -filetype=obj | spirv-val %}
+
+; CHECK: %[[#Q:]] = OpTypeStruct [[P:%[0-9]+]] [[P]]
+; CHECK: OpSelect %[[#Q]] %[[#]] %[[#]] %[[#]]
+; CHECK: OpSelect %[[#Q]] %[[#]] %[[#]] %[[#]]
+; CHECK: OpPhi %[[#Q]]
+
+%P = type { ptr addrspace(4), i32 }
+%Q = type { ptr addrspace(4), ptr addrspace(4) }
+
+define %P @a() {
+  ret %P { ptr addrspace(4) inttoptr (i64 4 to ptr addrspace(4)), i32 0 }
+}
+
+define i32 @a2() {
+  %v = load i32, ptr addrspace(4) inttoptr (i64 12 to ptr addrspace(4))
+  ret i32 %v
+}
+
+define %Q @b(i1 %c) {
+  %s = select i1 %c, %Q zeroinitializer, %Q { ptr addrspace(4) inttoptr (i64 8 to ptr addrspace(4)), ptr addrspace(4) inttoptr (i64 4 to ptr addrspace(4)) }
+  ret %Q %s
+}
+
+define %Q @typed(i1 %c) {
+  %s = select i1 %c, %Q zeroinitializer, %Q { ptr addrspace(4) inttoptr (i64 12 to ptr addrspace(4)), ptr addrspace(4) inttoptr (i64 8 to ptr addrspace(4)) }
+  ret %Q %s
+}
+
+define %Q @phi(i1 %c) {
+entry:
+  br i1 %c, label %then, label %join
+then:
+  br label %join
+join:
+  %p = phi %Q [ zeroinitializer, %entry ], [ { ptr addrspace(4) inttoptr (i64 12 to ptr addrspace(4)), ptr addrspace(4) null }, %then ]
+  ret %Q %p
+}
diff --git a/llvm/test/CodeGen/SPIRV/instructions/select-multi-register-aggregate-arms.ll b/llvm/test/CodeGen/SPIRV/instructions/select-multi-register-aggregate-arms.ll
new file mode 100644
index 000000000..6509ce89f
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/instructions/select-multi-register-aggregate-arms.ll
@@ -0,0 +1,34 @@
+; A multi-register aggregate arm of a select (here from llvm.sincos and
+; llvm.frexp) is rebuilt with insertvalue. The rebuilt chain must start from a
+; typed placeholder: starting from a bare poison, every such chain shared one
+; uniqued i32 value, so the second struct got the first one's type. With
+; SPV_KHR_poison_freeze the placeholders are OpPoisonKHR instead of OpUndef.
+
+; RUN: llc -O0 -mtriple=spirv64-unknown-unknown %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv64-unknown-unknown %s -o - -filetype=obj | spirv-val %}
+; RUN: llc -O0 -mtriple=spirv64-unknown-unknown --spirv-ext=+SPV_KHR_poison_freeze %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv64-unknown-unknown --spirv-ext=+SPV_KHR_poison_freeze %s -o - -filetype=obj | spirv-val %}
+
+; CHECK-DAG: %[[#Float:]] = OpTypeFloat 32
+; CHECK-DAG: %[[#Int:]] = OpTypeInt 32 0
+; CHECK-DAG: %[[#Pair:]] = OpTypeStruct %[[#Float]] %[[#Float]]
+; CHECK-DAG: %[[#Frexp:]] = OpTypeStruct %[[#Float]] %[[#Int]]
+; CHECK-DAG: %[[#PairInit:]] = {{OpUndef|OpPoisonKHR}} %[[#Pair]]
+; CHECK-DAG: %[[#FrexpInit:]] = {{OpUndef|OpPoisonKHR}} %[[#Frexp]]
+; CHECK: OpCompositeInsert %[[#Pair]] %[[#]] %[[#PairInit]] 0
+; CHECK: OpSelect %[[#Pair]]
+; CHECK: OpCompositeInsert %[[#Frexp]] %[[#]] %[[#FrexpInit]] 0
+; CHECK: OpSelect %[[#Frexp]]
+
+define spir_kernel void @k(ptr addrspace(1) %out, float %a, i1 %c) {
+  %sc = call { float, float } @llvm.sincos.f32(float %a)
+  %s1 = select i1 %c, { float, float } zeroinitializer, { float, float } %sc
+  %x = extractvalue { float, float } %s1, 0
+  store float %x, ptr addrspace(1) %out
+  %fe = call { float, i32 } @llvm.frexp.f32.i32(float %a)
+  %s2 = select i1 %c, { float, i32 } zeroinitializer, { float, i32 } %fe
+  %e = extractvalue { float, i32 } %s2, 1
+  %p = getelementptr inbounds i8, ptr addrspace(1) %out, i64 4
+  store i32 %e, ptr addrspace(1) %p
+  ret void
+}
