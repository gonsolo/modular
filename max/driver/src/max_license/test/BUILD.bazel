package(default_visibility = ["//visibility:public"])

# HAL device-execution tests for the Intel Level Zero plugin (Arc Pro B60).
#
# Each target runs a small kernel through the HAL `DeviceContext` and checks the
# result on the host, so a green run proves device execution dispatches through
# the `M_driver_*` HAL plugin named by `MODULAR_DRIVER_PLUGINS` (the
# `level_zero` plugin). Ported from the B60 HAL validation suite.
#
# `hal_test_dim` and `hal_test_targetinfo` are pure host-side (no kernel / no
# GPU); the rest launch a kernel on the device.
#
# The two local-memory tests (`proto_multiwarp`, `multiwarp_reduce`) stage in
# TRUE local (shared) memory (`unsafe_stack_allocation[.SHARED]`) and use a
# work-group `barrier()`. On the single pinned B60, cross-warp local-memory
# visibility is flaky under *concurrent* execution load (the staged values read
# back zero), so run the suite sequentially for a clean signal:
#   bazelw test --//:hal_device_context=true --jobs=1 //max/driver/src/max_license/test:*
# (They always pass in isolation or with --jobs=1. See the plan doc §2.7; this
# is a driver/IGC local-memory-visibility issue, not a test-runner artifact.)
#
# `ZE_AFFINITY_MASK=1` pins a single B60 (see the suite notes); drop it (or set
# it to the relevant card) to run on a different device.

hal_gpu_test("hal_test_add_constant")
hal_gpu_test("hal_test_buffer_io")
hal_gpu_test("hal_test_fast_div")
hal_gpu_test("hal_test_spirv_codegen")
hal_gpu_test("hal_test_prefetch")
hal_gpu_test("hal_test_barrier")
